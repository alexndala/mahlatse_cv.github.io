---
import Layout from '../layouts/Layout.astro';
import { personal } from '../data/personal';
---

<Layout title="About | Mahlatse Ndala" description={personal.summary}>
  <main id="main-content">
    <section class="section pt-32" aria-labelledby="about-heading">
      <div class="container-custom">
        <header class="mb-12 max-w-3xl">
          <h1 id="about-heading" class="section-title">About Me</h1>
          <p class="section-subtext mt-4">Professional journey, philosophy, and what drives me</p>
        </header>
        
        <div class="grid lg:grid-cols-3 gap-12">
          <!-- Main content -->
          <div class="lg:col-span-2 space-y-8">
            <article class="prose prose-slate max-w-none">
              <p class="text-text-secondary text-lg leading-relaxed mb-6">
                {personal.summary}
              </p>
              
              <h2 class="text-2xl font-bold text-text mt-10 mb-6">Professional Philosophy</h2>
              <div class="grid md:grid-cols-2 gap-6">
                <div class="card">
                  <div class="w-10 h-10 rounded-lg bg-primary/10 flex items-center justify-center mb-4">
                    <svg class="w-5 h-5 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
                  </div>
                  <h3 class="font-semibold text-text mb-2">Compliance-First</h3>
                  <p class="text-text-secondary">Building under POPIA, FAIS, FSCA, Reg 28, and Consumer Duty frameworks. Regulatory compliance isn't an afterthought—it's the foundation.</p>
                </div>
                <div class="card">
                  <div class="w-10 h-10 rounded-lg bg-primary/10 flex items-center justify-center mb-4">
                    <svg class="w-5 h-5 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/></svg>
                  </div>
                  <h3 class="font-semibold text-text mb-2">Evidence-Based</h3>
                  <p class="text-text-secondary">Monte Carlo simulations, MCMC optimisation, and rigorous backtesting drive every decision. No gut feelings—just math.</p>
                </div>
                <div class="card">
                  <div class="w-10 h-10 rounded-lg bg-primary/10 flex items-center justify-center mb-4">
                    <svg class="w-5 h-5 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
                  </div>
                  <h3 class="font-semibold text-text mb-2">End-to-End Ownership</h3>
                  <p class="text-text-secondary">From data pipelines to Excel frontends, from ETL to portfolio analytics. Full-stack ownership means no handoff gaps.</p>
                </div>
                <div class="card">
                  <div class="w-10 h-10 rounded-lg bg-primary/10 flex items-center justify-center mb-4">
                    <svg class="w-5 h-5 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"/></svg>
                  </div>
                  <h3 class="font-semibold text-text mb-2">Continuous Learning</h3>
                  <p class="text-text-secondary">MSc Financial Engineering (current), 15+ certifications across AWS, AI, quant finance. The best models evolve.</p>
                </div>
              </div>
              
              <h2 class="text-2xl font-bold text-text mt-10 mb-6">What I'm Building</h2>
              <p class="text-text-secondary leading-relaxed mb-6">
                Independently building <strong>Absolute Labs</strong>—a suite of fintech products for the South African wealth management market:
              </p>
              <ul class="space-y-3 text-text-secondary" role="list">
                <li class="flex gap-3"><strong class="text-text min-w-[100px]">Absolute:</strong> Goals-based financial planning SaaS for IFAs with Monte Carlo scoring, Reg 28/TFSA/RA compliance, and MCMC optimisation.</li>
                <li class="flex gap-3"><strong class="text-text min-w-[100px]">Ndlela:</strong> Client-facing personal finance platform—the consumer layer of the Absolute ecosystem.</li>
                <li class="flex gap-3"><strong class="text-text min-w-[100px]">Parity:</strong> Free algorithm-based fund matching engine ranking 700+ SA unit trusts across 40 ASISA sectors.</li>
                <li class="flex gap-3"><strong class="text-text min-w-[100px]">Calenda:</strong> Bloomberg-style earnings & corporate actions research cockpit with beat/miss analytics.</li>
              </ul>
            </article>
          </div>
          
          <!-- Sidebar -->
          <aside class="space-y-6">
            <div class="card">
              <h3 class="font-semibold text-text mb-4">Contact</h3>
              <ul class="space-y-3 text-text-secondary" role="list">
                <li class="flex items-center gap-3">
                  <svg class="w-5 h-5 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
                  <a href="mailto:axndala@gmail.com" class="hover:text-primary transition-colors">axndala@gmail.com</a>
                </li>
                <li class="flex items-center gap-3">
                  <svg class="w-5 h-5 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
                  <span>North West, South Africa</span>
                </li>
                <li class="flex items-center gap-3">
                  <svg class="w-5 h-5 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
                  <a href="tel:+27799086236" class="hover:text-primary transition-colors">+27 79 908 6236</a>
                </li>
              </ul>
            </div>
            
            <div class="card">
              <h3 class="font-semibold text-text mb-4">Links</h3>
              <ul class="space-y-3" role="list">
                <li><a href="https://linkedin.com/in/mahlatsendala" target="_blank" rel="noopener noreferrer" class="flex items-center gap-3 text-text-secondary hover:text-primary transition-colors"><svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/></svg> LinkedIn</a></li>
                <li><a href="https://github.com/alexndala" target="_blank" rel="noopener noreferrer" class="flex items-center gap-3 text-text-secondary hover:text-primary transition-colors"><svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M12 0C5.374 0 0 5.373 0 12c0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23A11.509 11.509 0 0112 5.803c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576C20.566 21.797 24 17.3 24 12c0-6.627-5.373-12-12-12z"/></svg> GitHub</a></li>
              </ul>
            </div>
            
            <div class="card">
              <h3 class="font-semibold text-text mb-4">Currently</h3>
              <ul class="space-y-2 text-text-secondary text-sm" role="list">
                <li>📚 MSc Financial Engineering (WorldQuant University)</li>
                <li>☁️ AWS Certified AI Practitioner (Exam Prep)</li>
                <li>🚀 Building Absolute Labs products</li>
                <li>🏃 Marathon training</li>
              </ul>
            </div>
          </aside>
        </div>
      </div>
    </section>
  </main>
</Layout>