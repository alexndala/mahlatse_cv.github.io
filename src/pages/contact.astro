---
import Layout from '../layouts/Layout.astro';
import { personal } from '../data/personal';
---

<Layout title="Contact | Mahlatse Ndala" description="Get in touch with Mahlatse Ndala - Lead Multi-Asset Quantitative Analyst & Developer">
  <main id="main-content">
    <section class="section pt-32" aria-labelledby="contact-heading">
      <div class="container-custom">
        <header class="mb-12 max-w-2xl text-center mx-auto">
          <h1 id="contact-heading" class="section-title">Get in Touch</h1>
          <p class="section-subtext mt-4">Open to opportunities in quantitative finance, fintech, data engineering, and software development</p>
        </header>
        
        <div class="max-w-2xl mx-auto">
          <!-- Contact Cards -->
          <div class="grid md:grid-cols-3 gap-6 mb-12">
            <a href="mailto:axndala@gmail.com" class="card-hover group text-center p-8">
              <div class="w-16 h-16 rounded-xl bg-primary/10 flex items-center justify-center mx-auto mb-4 group-hover:bg-primary group-hover:text-white transition-colors">
                <svg class="w-8 h-8 text-primary group-hover:text-white transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
              </div>
              <h3 class="font-semibold text-text mb-1">Email</h3>
              <p class="text-text-secondary text-sm">axndala@gmail.com</p>
            </a>
            
            <a href="https://linkedin.com/in/mahlatsendala" target="_blank" rel="noopener noreferrer" class="card-hover group text-center p-8">
              <div class="w-16 h-16 rounded-xl bg-primary/10 flex items-center justify-center mx-auto mb-4 group-hover:bg-primary group-hover:text-white transition-colors">
                <svg class="w-8 h-8 text-primary group-hover:text-white transition-colors" fill="currentColor" viewBox="0 0 24 24"><path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/></svg>
              </div>
              <h3 class="font-semibold text-text mb-1">LinkedIn</h3>
              <p class="text-text-secondary text-sm">linkedin.com/in/mahlatsendala</p>
            </a>
            
            <a href="https://github.com/alexndala" target="_blank" rel="noopener noreferrer" class="card-hover group text-center p-8">
              <div class="w-16 h-16 rounded-xl bg-primary/10 flex items-center justify-center mx-auto mb-4 group-hover:bg-primary group-hover:text-white transition-colors">
                <svg class="w-8 h-8 text-primary group-hover:text-white transition-colors" fill="currentColor" viewBox="0 0 24 24"><path d="M12 0C5.374 0 0 5.373 0 12c0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23A11.509 11.509 0 0112 5.803c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576C20.566 21.797 24 17.3 24 12c0-6.627-5.373-12-12-12z"/></svg>
              </div>
              <h3 class="font-semibold text-text mb-1">GitHub</h3>
              <p class="text-text-secondary text-sm">github.com/alexndala</p>
            </a>
          </div>
          
          <!-- Contact Form Alternative -->
          <div class="card text-center">
            <h2 class="text-xl font-bold text-text mb-4">Prefer a Direct Message?</h2>
            <p class="text-text-secondary mb-6 max-w-md mx-auto">
              I'm always interested in hearing about new opportunities, interesting problems, or potential collaborations. 
              Whether it's quantitative finance, fintech product development, data engineering, or software architecture—let's connect.
            </p>
            <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
              <a href="mailto:axndala@gmail.com?subject=Opportunity%20Inquiry&body=Hi%20Mahlatse%2C%0A%0AI%20came%20across%20your%20profile%20and%20wanted%20to%20connect%20about%20..." class="btn-primary">
                <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
                Send Email
              </a>
              <a href="https://linkedin.com/in/mahlatsendala" target="_blank" rel="noopener noreferrer" class="btn-secondary">
                <svg class="w-5 h-5 mr-2" fill="currentColor" viewBox="0 0 24 24"><path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/></svg>
                Connect on LinkedIn
              </a>
            </div>
          </div>
          
          <!-- Availability -->
          <div class="mt-12 card bg-primary/5 border-primary/10">
            <h3 class="font-semibold text-text mb-4 text-center">Currently Open To</h3>
            <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-4 text-center">
              <div class="p-4 rounded-lg bg-bg border border-border">
                <div class="text-2xl font-bold text-primary mb-1">💼</div>
                <div class="font-medium text-text">Full-time Roles</div>
                <p class="text-text-secondary text-sm">Quant Analyst, Data Engineer, Software Engineer</p>
              </div>
              <div class="p-4 rounded-lg bg-bg border border-border">
                <div class="text-2xl font-bold text-primary mb-1">🤝</div>
                <div class="font-medium text-text">Consulting</div>
                <p class="text-text-secondary text-sm">Quant modelling, platform architecture, fintech</p>
              </div>
              <div class="p-4 rounded-lg bg-bg border border-border">
                <div class="text-2xl font-bold text-primary mb-1">🚀</div>
                <div class="font-medium text-text">Collaboration</div>
                <p class="text-text-secondary text-sm">Open source, research, product development</p>
              </div>
              <div class="p-4 rounded-lg bg-bg border border-border">
                <div class="text-2xl font-bold text-primary mb-1">🎤</div>
                <div class="font-medium text-text">Speaking</div>
                <p class="text-text-secondary text-sm">Quant finance, fintech, career transitions</p>
              </div>
            </div>
          </div>
          
          <!-- Location -->
          <div class="mt-8 text-center text-text-secondary">
            <p class="flex items-center justify-center gap-2">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
              <span>Based in North West, South Africa · Open to remote & hybrid</span>
            </p>
            <p class="mt-2">Timezone: SAST (UTC+2) · Available for global collaboration</p>
          </div>
        </div>
      </div>
    </section>
  </main>
</Layout>