---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import { personal } from '../data/personal';
import { experience } from '../data/experience';
import { projects } from '../data/projects';
import { skillCategories } from '../data/skills';
import { certifications } from '../data/certifications';
import TimelineItem from '../components/TimelineItem.astro';
import ProjectCard from '../components/ProjectCard.astro';
import SkillCloud from '../components/SkillCloud.astro';
import CertCard from '../components/CertCard.astro';
---

<Layout title="Mahlatse Ndala | Lead Multi-Asset Quantitative Analyst & Developer" description={personal.summary}>
  <main id="main-content">
    <!-- Hero Section -->
    <Hero 
      name={personal.name}
      title={personal.title}
      subtitle={personal.subtitle}
      highlights={personal.highlights}
      email={personal.email}
      linkedin={personal.linkedin}
      github={personal.github}
    />
    
    <!-- About Preview -->
    <section id="about" class="section bg-bg-secondary" aria-labelledby="about-heading">
      <div class="container-custom">
        <header class="mb-12">
          <h2 id="about-heading" class="section-title">About</h2>
          <p class="section-subtext">Professional summary and core philosophy</p>
        </header>
        
        <div class="prose prose-slate max-w-none">
          <p class="text-text-secondary text-lg leading-relaxed mb-6">
            {personal.summary.split('. ').slice(0, 3).join('. ')}.
          </p>
          <div class="grid md:grid-cols-2 gap-8">
            <div>
              <h3 class="font-semibold text-text mb-3">Core Philosophy</h3>
              <ul class="space-y-2 text-text-secondary" role="list">
                <li class="flex gap-2"><svg class="w-5 h-5 text-primary flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg> Compliance-first development</li>
                <li class="flex gap-2"><svg class="w-5 h-5 text-primary flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg> Evidence-based decision making</li>
                <li class="flex gap-2"><svg class="w-5 h-5 text-primary flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg> End-to-end ownership</li>
                <li class="flex gap-2"><svg class="w-5 h-5 text-primary flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg> Continuous learning</li>
              </ul>
            </div>
            <div>
              <h3 class="font-semibold text-text mb-3">Key Domains</h3>
              <ul class="space-y-2 text-text-secondary" role="list">
                <li class="flex gap-2"><svg class="w-5 h-5 text-accent flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg> Multi-Asset Portfolio Construction</li>
                <li class="flex gap-2"><svg class="w-5 h-5 text-accent flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg> Quantitative Model Development</li>
                <li class="flex gap-2"><svg class="w-5 h-5 text-accent flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg> Financial Data Engineering</li>
                <li class="flex gap-2"><svg class="w-5 h-5 text-accent flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg> Fintech Product Development</li>
              </ul>
            </div>
          </div>
        </div>
        
        <div class="mt-8 text-center">
          <a href="/about" class="btn-secondary">Read Full Story →</a>
        </div>
      </div>
    </section>
    
    <!-- Featured Experience -->
    <section class="section" aria-labelledby="experience-heading">
      <div class="container-custom">
        <header class="mb-12">
          <h2 id="experience-heading" class="section-title">Featured Experience</h2>
          <p class="section-subtext">Leading quantitative platforms and building fintech products</p>
        </header>
        
        <div class="space-y-8">
          {experience.filter(e => e.featured).map((exp) => (
            <TimelineItem 
              company={exp.company}
              role={exp.role}
              period={exp.period}
              description={exp.description}
              bullets={exp.bullets}
              tech={exp.tech}
              featured={exp.featured}
            />
          ))}
        </div>
        
        <div class="mt-8 text-center">
          <a href="/experience" class="btn-secondary">View All Experience →</a>
        </div>
      </div>
    </section>
    
    <!-- Projects -->
    <section id="projects" class="section bg-bg-secondary" aria-labelledby="projects-heading">
      <div class="container-custom">
        <header class="mb-12">
          <h2 id="projects-heading" class="section-title">Fintech Products</h2>
          <p class="section-subtext">Building the Absolute Labs ecosystem for South African wealth management</p>
        </header>
        
        <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6">
          {projects.map((project) => (
            <ProjectCard 
              name={project.name}
              tagline={project.tagline}
              description={project.description}
              longDescription={project.longDescription}
              features={project.features}
              tech={project.tech}
              status={project.status}
              category={project.category}
              link={project.link}
              github={project.github}
            />
          ))}
        </div>
        
        <div class="mt-8 text-center">
          <a href="/projects" class="btn-secondary">View All Projects →</a>
        </div>
      </div>
    </section>
    
    <!-- Skills Preview -->
    <section id="skills" class="section" aria-labelledby="skills-heading">
      <div class="container-custom">
        <header class="mb-12">
          <h2 id="skills-heading" class="section-title">Technical Skills</h2>
          <p class="section-subtext">Categorized expertise across quant, engineering, and data domains</p>
        </header>
        
        <SkillCloud categories={skillCategories} />
        
        <div class="mt-8 text-center">
          <a href="/skills" class="btn-secondary">View All Skills →</a>
        </div>
      </div>
    </section>
    
    <!-- Certifications Preview -->
    <section id="certifications" class="section bg-bg-secondary" aria-labelledby="certifications-heading">
      <div class="container-custom">
        <header class="mb-12">
          <h2 id="certifications-heading" class="section-title">Certifications</h2>
          <p class="section-subtext">Continuous learning across cloud, AI, finance, and data</p>
        </header>
        
        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
          {certifications.filter(c => c.featured).map((cert) => (
            <CertCard cert={cert} />
          ))}
        </div>
        
        <div class="mt-8 text-center">
          <a href="/certifications" class="btn-secondary">View All Certifications →</a>
        </div>
      </div>
    </section>
    
    <!-- CTA -->
    <section class="section" aria-labelledby="cta-heading">
      <div class="container-custom">
        <div class="card bg-primary text-white text-center max-w-2xl mx-auto">
          <h2 id="cta-heading" class="text-3xl font-bold mb-4">Let's Build Something Great</h2>
          <p class="text-primary-100 mb-8 text-lg">
            Open to opportunities in quantitative finance, fintech, data engineering, and software development. 
            Let's connect and explore how we can create value together.
          </p>
          <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
            <a href="mailto:axndala@gmail.com" class="btn bg-white text-primary hover:bg-gray-100 w-full sm:w-auto">
              <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
              Email Me
            </a>
            <a href="https://linkedin.com/in/mahlatsendala" target="_blank" rel="noopener noreferrer" class="btn bg-white/10 text-white hover:bg-white/20 border border-white/20 w-full sm:w-auto">
              <svg class="w-5 h-5 mr-2" fill="currentColor" viewBox="0 0 24 24"><path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/></svg>
              LinkedIn
            </a>
          </div>
        </div>
      </div>
    </section>
  </main>
</Layout>