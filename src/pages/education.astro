---
import Layout from '../layouts/Layout.astro';
import { personal } from '../data/personal';
import { education, additionalCertifications } from '../data/education';
---

<Layout title="Education | Mahlatse Ndala" description="Education background: MSc Financial Engineering, WeThinkCode, WorldQuant University, Stellenbosch University">
  <main id="main-content">
    <section class="section pt-32" aria-labelledby="education-heading">
      <div class="container-custom">
        <header class="mb-12 max-w-3xl">
          <h1 id="education-heading" class="section-title">Education</h1>
          <p class="section-subtext mt-4">Academic background and professional qualifications</p>
        </header>
        
        <div class="max-w-3xl space-y-8">
          {education.map((edu) => (
            <article class="card-hover">
              <header class="mb-4">
                <div class="flex flex-col sm:flex-row sm:items-start sm:justify-between gap-4 mb-3">
                  <div>
                    <div class="flex items-center gap-2 mb-1">
                      <span class="text-sm font-semibold text-primary">{edu.period}</span>
                      {edu.status === 'Current' && (
                        <span class="badge bg-blue-100 text-blue-700 border-blue-200 text-xs">In Progress</span>
                      )}
                      {edu.status === 'Incomplete' && (
                        <span class="badge bg-yellow-100 text-yellow-700 border-yellow-200 text-xs">Incomplete</span>
                      )}
                    </div>
                    <h2 class="text-xl font-bold text-text">{edu.degree}</h2>
                    <p class="text-text-secondary font-medium">{edu.institution}</p>
                  </div>
                </div>
                
                {edu.details && edu.details.length > 0 && (
                  <ul class="space-y-2 text-text-secondary" role="list">
                    {edu.details.map((detail) => (
                      <li class="flex gap-3">
                        <svg class="w-5 h-5 text-primary flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                        <span>{detail}</span>
                      </li>
                    ))}
                  </ul>
                )}
              </header>
              
              {edu.certifications && edu.certifications.length > 0 && (
                <div class="pt-4 border-t border-border">
                  <h4 class="text-sm font-semibold text-text-secondary mb-3">Key Coursework & Certifications</h4>
                  <div class="flex flex-wrap gap-2" role="list" aria-label="Certifications">
                    {edu.certifications.map((cert) => (
                      <span class="skill-tag text-xs" role="listitem">{cert}</span>
                    ))}
                  </div>
                </div>
              )}
            </article>
          ))}
        </div>
        
        <!-- Additional Certifications -->
        <section class="mt-16" aria-labelledby="additional-heading">
          <header class="mb-8">
            <h2 id="additional-heading" class="text-2xl font-bold text-text">Additional Professional Certifications</h2>
            <p class="text-text-secondary mt-1">Industry-recognized credentials complementing formal education</p>
          </header>
          
          <div class="grid md:grid-cols-3 gap-6">
            {additionalCertifications.map((cert) => (
              <article class="card-hover">
                <div class="flex items-start gap-4">
                  <div class="w-12 h-12 rounded-xl bg-primary/10 flex items-center justify-center text-2xl" aria-hidden="true">
                    {cert.name.includes('AWS') && '☁️' || cert.name.includes('Git') && '📝' || cert.name.includes('AI') && '🤖'}
                  </div>
                  <div>
                    <h3 class="font-semibold text-text">{cert.name}</h3>
                    <p class="text-text-secondary text-sm mt-1">{cert.issuer} · {cert.date}</p>
                    <span class={`inline-block mt-2 text-xs font-medium ${cert.status === 'Completed' ? 'text-green-600' : 'text-blue-600'}`}>
                      {cert.status}
                    </span>
                  </div>
                </div>
              </article>
            ))}
          </div>
        </section>
        
        <!-- Continuous Learning -->
        <section class="mt-16" aria-labelledby="learning-heading">
          <header class="mb-8">
            <h2 id="learning-heading" class="text-2xl font-bold text-text">Continuous Learning Philosophy</h2>
            <p class="text-text-secondary mt-1">Staying at the intersection of quantitative finance, software engineering, and AI</p>
          </header>
          
          <div class="grid md:grid-cols-3 gap-6">
            <div class="card">
              <h3 class="font-semibold text-text mb-3">Quantitative Finance</h3>
              <ul class="space-y-2 text-text-secondary text-sm" role="list">
                <li>MSc Financial Engineering (WQU)</li>
                <li>Investment & Portfolio Management (Rice)</li>
                <li>Investment Risk Management (Coursera)</li>
                <li>Python for Financial Analysis (HKUST)</li>
              </ul>
            </div>
            <div class="card">
              <h3 class="font-semibold text-text mb-3">Software & Data Engineering</h3>
              <ul class="space-y-2 text-text-secondary text-sm" role="list">
                <li>Associate's in Software & Data Eng (WeThinkCode)</li>
                <li>Applied Data Science Certificate (WQU)</li>
                <li>Git Version Control (CodeAcademy)</li>
                <li>Data Analysis in Excel (Dataquest)</li>
              </ul>
            </div>
            <div class="card">
              <h3 class="font-semibold text-text mb-3">Cloud & AI</h3>
              <ul class="space-y-2 text-text-secondary text-sm" role="list">
                <li>AWS AI Practitioner (In Progress)</li>
                <li>Introduction to GenAI (AWS)</li>
                <li>Artificial Intelligence (IBM)</li>
                <li>Data Science & AI Ethics (IBM)</li>
              </ul>
            </div>
          </div>
        </section>
      </div>
    </section>
  </main>
</Layout>