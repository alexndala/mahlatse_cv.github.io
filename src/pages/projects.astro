---
import Layout from '../layouts/Layout.astro';
import { personal } from '../data/personal';
import { projects } from '../data/projects';
import ProjectCard from '../components/ProjectCard.astro';
---

<Layout title="Projects | Mahlatse Ndala" description="Fintech products: Absolute, Ndlela, Parity, Calenda">
  <main id="main-content">
    <section class="section pt-32" aria-labelledby="projects-heading">
      <div class="container-custom">
        <header class="mb-12 max-w-3xl">
          <h1 id="projects-heading" class="section-title">Fintech Products</h1>
          <p class="section-subtext mt-4">Building the Absolute Labs ecosystem for South African wealth management</p>
        </header>
        
        <!-- Overview -->
        <div class="card mb-12 max-w-4xl">
          <h2 class="text-xl font-bold text-text mb-4">The Absolute Labs Ecosystem</h2>
          <p class="text-text-secondary leading-relaxed mb-6">
            Independently building and commercialising a suite of fintech products for the South African wealth management, 
            IFA, and capital markets research sectors. All products are built under POPIA, FAIS, and FSCA regulatory frameworks 
            with a compliance-first development philosophy.
          </p>
          <div class="grid md:grid-cols-4 gap-4 text-sm">
            <div class="flex items-center gap-2 text-text-secondary"><svg class="w-5 h-5 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>4 Products</div>
            <div class="flex items-center gap-2 text-text-secondary"><svg class="w-5 h-5 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>700+ Funds Analyzed</div>
            <div class="flex items-center gap-2 text-text-secondary"><svg class="w-5 h-5 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>6 Risk Models</div>
            <div class="flex items-center gap-2 text-text-secondary"><svg class="w-5 h-5 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>POPIA/FAIS/FSCA Compliant</div>
          </div>
        </div>
        
        <!-- Project Cards -->
        <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6">
          {projects.map((project) => (
            <ProjectCard 
              name={project.name}
              tagline={project.tagline}
              description={project.description}
              longDescription={project.longDescription}
              features={project.features}
              tech={project.tech}
              status={project.status}
              category={project.category}
              link={project.link}
              github={project.github}
            />
          ))}
        </div>
        
        <!-- Detailed view for each project -->
        <div class="mt-20 space-y-16">
          {projects.map((project) => (
            <article id={project.name.toLowerCase()} class="card">
              <header class="mb-8">
                <div class="flex items-center gap-3 mb-4">
                  <span class={`badge ${project.category === 'SaaS' ? 'bg-primary/10 text-primary border-primary/20' : project.category === 'Client-Facing' ? 'bg-accent/10 text-accent-dark border-accent/20' : project.category === 'Research Tool' ? 'bg-green-100 text-green-700 border-green-200' : 'bg-purple-100 text-purple-700 border-purple-200'}`}>
                    {project.category}
                  </span>
                  <span class={`badge ${project.status === 'Live' ? 'bg-green-100 text-green-700 border-green-200' : project.status === 'In Development' ? 'bg-blue-100 text-blue-700 border-blue-200' : 'bg-purple-100 text-purple-700 border-purple-200'}`}>
                    {project.status}
                  </span>
                </div>
                <h2 class="text-3xl font-bold text-text">{project.name}</h2>
                <p class="text-xl text-text-secondary mt-2">{project.tagline}</p>
              </header>
              
              <div class="prose prose-slate max-w-none">
                <p class="text-text-secondary leading-relaxed mb-6">{project.description}</p>
                
                <h3 class="text-lg font-semibold text-text mb-3">Key Features</h3>
                <ul class="space-y-2 mb-6" role="list">
                  {project.longDescription.map((desc) => (
                    <li class="flex gap-3 text-text-secondary">
                      <svg class="w-5 h-5 text-primary flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                      <span>{desc}</span>
                    </li>
                  ))}
                </ul>
                
                <h3 class="text-lg font-semibold text-text mb-3">Technology Stack</h3>
                <div class="flex flex-wrap gap-2" role="list" aria-label="Technologies used">
                  {project.tech.map((t) => (
                    <span class="skill-tag" role="listitem">{t}</span>
                  ))}
                </div>
              </div>
              
              {(project.link || project.github) && (
                <footer class="mt-8 pt-6 border-t border-border flex flex-wrap gap-4">
                  {project.link && (
                    <a href={project.link} target="_blank" rel="noopener noreferrer" class="btn-primary">
                      <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
                      Live Demo
                    </a>
                  )}
                  {project.github && (
                    <a href={project.github} target="_blank" rel="noopener noreferrer" class="btn-secondary">
                      <svg class="w-5 h-5 mr-2" fill="currentColor" viewBox="0 0 24 24"><path d="M12 0C5.374 0 0 5.373 0 12c0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23A11.509 11.509 0 0112 5.803c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576C20.566 21.797 24 17.3 24 12c0-6.627-5.373-12-12-12z"/></svg>
                      View Code
                    </a>
                  )}
                </footer>
              )}
            </article>
          ))}
        </div>
      </div>
    </section>
  </main>
</Layout>