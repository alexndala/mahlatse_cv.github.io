---
interface Props {
  cert: import('../data/certifications').Certification;
}

const { cert } = Astro.props;

const categoryIcons: Record<string, string> = {
  "Cloud/AWS": "☁️",
  "AI/ML": "🤖",
  "Finance/Quant": "📈",
  "Data": "📊",
  "Software Engineering": "💻",
  "Professional": "🎓",
  "Blockchain": "⛓️",
};

const icon = categoryIcons[cert.category] || "🏆";
---

<article class="card-hover group">
  <div class="flex items-start justify-between gap-4 mb-3">
    <div class="flex items-center gap-3">
      <div class="w-12 h-12 rounded-xl bg-primary/10 flex items-center justify-center text-2xl" aria-hidden="true">
        {icon}
      </div>
      <div>
        <h3 class="font-semibold text-text group-hover:text-primary transition-colors">{cert.name}</h3>
        <p class="text-sm text-text-secondary">{cert.issuer}</p>
      </div>
    </div>
    <div class="text-right">
      <span class="badge-primary text-xs">{cert.date}</span>
      <span class={`badge ${cert.featured ? "badge-accent" : "badge-primary"} text-xs ml-1`}>{cert.category}</span>
    </div>
  </div>
  
  <div class="flex flex-wrap gap-1.5 mb-4" role="list" aria-label="Skills">
    {cert.skills.map((skill) => (
      <span class="skill-tag text-xs" role="listitem">{skill}</span>
    ))}
  </div>
  
  <div class="flex items-center gap-4 pt-3 border-t border-border">
    {cert.credentialUrl && (
      <a href={cert.credentialUrl} target="_blank" rel="noopener noreferrer" class="text-sm font-medium text-primary hover:text-primary-light flex items-center gap-1 transition-colors">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1" />
        </svg>
        Verify
      </a>
    )}
    {cert.credentialId && !cert.credentialUrl && (
      <span class="text-sm text-text-secondary font-mono" title="Credential ID">
        ID: {cert.credentialId.slice(0, 12)}...
      </span>
    )}
  </div>
</article>