---
interface Props {
  name: string;
  tagline: string;
  description: string;
  longDescription: string[];
  features: string[];
  tech: string[];
  status: "Live" | "In Development" | "Concept";
  category: "SaaS" | "Client-Facing" | "Research Tool" | "Matching Engine";
  link?: string;
  github?: string;
}

const { name, tagline, description, longDescription, features, tech, status, category, link, github } = Astro.props;

const statusConfig = {
  Live: { bg: "bg-green-100 text-green-700 border-green-200", icon: "check-circle" },
  "In Development": { bg: "bg-blue-100 text-blue-700 border-blue-200", icon: "code" },
  Concept: { bg: "bg-purple-100 text-purple-700 border-purple-200", icon: "lightbulb" },
};

const categoryConfig = {
  SaaS: { bg: "bg-primary/10 text-primary border-primary/20" },
  "Client-Facing": { bg: "bg-accent/10 text-accent-dark border-accent/20" },
  "Research Tool": { bg: "bg-green-100 text-green-700 border-green-200" },
  "Matching Engine": { bg: "bg-purple-100 text-purple-700 border-purple-200" },
};

const statusStyles = statusConfig[status];
const categoryStyles = categoryConfig[category];
---

<article class="card-hover group h-full flex flex-col">
  <div class="flex items-start justify-between gap-4 mb-4">
    <div class="flex-1">
      <div class="flex items-center gap-2 mb-2">
        <span class={`badge ${categoryStyles}`}>{category}</span>
        <span class={`badge ${statusStyles.bg} border ${statusStyles.border}`}>{status}</span>
      </div>
      <h3 class="text-xl font-bold text-text group-hover:text-primary transition-colors">{name}</h3>
    </div>
  </div>
  
  <p class="text-text-secondary mb-4 leading-relaxed flex-1">{tagline}</p>
  
  <div class="mb-4">
    <h4 class="text-sm font-semibold text-text-secondary mb-2">Key Features</h4>
    <ul class="space-y-1.5" role="list">
      {features.map((feature) => (
        <li class="flex gap-2 text-sm text-text-secondary">
          <svg class="w-4 h-4 text-primary flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
          </svg>
          <span>{feature}</span>
        </li>
      ))}
    </ul>
  </div>
  
  <div class="mb-4">
    <h4 class="text-sm font-semibold text-text-secondary mb-2">Tech Stack</h4>
    <div class="flex flex-wrap gap-2" role="list" aria-label="Technologies used">
      {tech.slice(0, 8).map((t) => (
        <span class="skill-tag" role="listitem">{t}</span>
      ))}
      {tech.length > 8 && (
        <span class="skill-tag text-text-muted">+{tech.length - 8} more</span>
      )}
    </div>
  </div>
  
  <div class="flex items-center gap-4 pt-4 border-t border-border mt-auto">
    {link && (
      <a href={link} target="_blank" rel="noopener noreferrer" class="text-sm font-medium text-primary hover:text-primary-light flex items-center gap-1 transition-colors">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
        </svg>
        Live Demo
      </a>
    )}
    {github && (
      <a href={github} target="_blank" rel="noopener noreferrer" class="text-sm font-medium text-text-secondary hover:text-primary flex items-center gap-1 transition-colors">
        <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M12 0C5.374 0 0 5.373 0 12c0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23A11.509 11.509 0 0112 5.803c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576C20.566 21.797 24 17.3 24 12c0-6.627-5.373-12-12-12z" />
        </svg>
        Code
      </a>
    )}
  </div>
</article>